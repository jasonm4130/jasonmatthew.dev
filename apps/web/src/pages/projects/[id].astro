---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import { getCollection, render } from 'astro:content';
import { isPublished } from '@utils/data-utils';
import { parseInternalHref } from '@utils/content-graph';
import { getContentGraph, getThread } from '@utils/content-graph-astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import ExternalLink from '@icons/ExternalLink.astro';
import GitHub from '@icons/GitHub.astro';

export const getStaticPaths = (async () => {
  const projects = await getCollection('projects', isPublished);
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { project } = Astro.props as Props;
const { Content } = await render(project);

// Related cross-links, gated on the target being published. The build gate already
// fails closed on a related link to a missing/unpublished entry, so this is defence
// in depth: internal links resolve to a published entry, external links pass through.
const graph = await getContentGraph();
const publishedKeys = new Set(graph.all.filter((e) => e.published).map((e) => `${e.collection}:${e.id}`));
const related = (project.data.related ?? []).filter((link) => {
  const target = parseInternalHref(link.href);
  return !target || publishedKeys.has(`${target.collection}:${target.id}`);
});

const threads = project.data.threads.map(getThread).filter((t): t is NonNullable<typeof t> => t != null);
const metrics = project.data.metrics ?? [];
---

<BaseLayout title={project.data.title} description={project.data.description}>
  <article>
    <header class="mb-10">
      <div class="proj-kicker">Project</div>
      <h1 class="font-700 mt-2 font-sans text-3xl md:text-4xl">{project.data.title}</h1>
      <p class="mt-4 text-lg text-[var(--color-muted)]">{project.data.description}</p>

      <div class="mt-6 flex flex-wrap items-center gap-4">
        {
          project.data.liveUrl && (
            <a
              href={project.data.liveUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="font-600 inline-flex items-center gap-1.5 font-sans text-sm text-[var(--color-accent)]"
            >
              Live site <ExternalLink class="h-4 w-4" />
            </a>
          )
        }
        {
          project.data.githubUrl && (
            <a
              href={project.data.githubUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="font-600 inline-flex items-center gap-1.5 font-sans text-sm text-[var(--color-accent)]"
            >
              Source <GitHub class="h-4 w-4" />
            </a>
          )
        }
      </div>

      {
        threads.length > 0 && (
          <div class="proj-threads">
            <span class="proj-threads-h">Threads</span>
            {threads.map((t) => (
              <a href={`/threads/${t.slug}`}>{t.title}</a>
            ))}
          </div>
        )
      }

      {
        project.data.technologies.length > 0 && (
          <div class="mt-4 flex flex-wrap gap-2">
            {project.data.technologies.map((tech: string) => (
              <span class="border border-[var(--color-border)] bg-[var(--color-surface)] px-2.5 py-1 font-sans text-xs text-[var(--color-muted)]">
                {tech}
              </span>
            ))}
          </div>
        )
      }
    </header>

    {
      metrics.length > 0 && (
        <div class="metrics">
          {metrics.map((m) => (
            <div class="metric">
              <span class="metric-val">{m.value}</span>
              <span class="metric-label">{m.label}</span>
            </div>
          ))}
        </div>
      )
    }

    <div class="prose art-prose case-narrow max-w-none">
      <Content />
    </div>

    {
      related.length > 0 && (
        <footer class="related">
          <span class="related-h">Related</span>
          <ul class="related-list">
            {related.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))}
          </ul>
        </footer>
      )
    }
  </article>
</BaseLayout>

<style>
  .proj-kicker {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--muted);
  }

  .proj-threads {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px 14px;
    margin-top: 20px;
  }

  .proj-threads-h {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.13em;
    color: var(--faint);
  }

  .proj-threads a {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.18s ease;
  }

  .proj-threads a:hover {
    color: var(--coral);
  }

  .metrics {
    display: flex;
    flex-wrap: wrap;
    gap: 28px 44px;
    margin: 0 0 32px;
    padding: 20px 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .metric {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .metric-val {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 1.5rem;
    letter-spacing: -0.02em;
    color: var(--coral);
  }

  .metric-label {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--faint);
  }

  .related {
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
  }

  .related-h {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--faint);
  }

  .related-list {
    list-style: none;
    margin: 12px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .related-list a {
    font-family: var(--font-sans);
    font-size: 0.95rem;
    color: var(--coral);
    text-decoration: none;
  }

  .related-list a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .proj-threads a {
      transition: none;
    }
  }
</style>
