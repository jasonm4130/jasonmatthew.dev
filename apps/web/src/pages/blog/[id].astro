---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import { getCollection, render } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import FormattedDate from '@components/FormattedDate.astro';
import { isNotDraft } from '@utils/data-utils';

export const getStaticPaths = (async () => {
  // Intentional: individual post pages use isNotDraft (not isPublished), so a
  // draft:false post with a future publishDate gets a live /blog/<slug>/ URL for
  // OG-image generation and in-situ review before launch. Listings, RSS, tags and
  // the homepage all gate on the date via isPublished, and astro.config.mjs keeps
  // these pre-publish pages out of the sitemap. See src/utils/data-utils.ts.
  const posts = await getCollection('blog', isNotDraft);
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { post } = Astro.props as Props;
const { Content } = await render(post);
---

<BaseLayout title={post.data.title} description={post.data.excerpt} pageType="article">
  <article>
    <header class="mb-10">
      <h1 class="font-700 font-sans text-3xl md:text-4xl">{post.data.title}</h1>
      <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2 font-sans text-sm text-[var(--color-muted)]">
        <span class="whitespace-nowrap">
          <FormattedDate date={post.data.publishDate} />
        </span>
        {
          post.data.tags.length > 0 && (
            <div class="flex flex-wrap gap-x-3 gap-y-2">
              {post.data.tags.map((tag: string) => (
                <a href={`/tags/${tag}`} class="whitespace-nowrap text-[var(--color-accent)]">
                  #{tag}
                </a>
              ))}
            </div>
          )
        }
      </div>
    </header>
    <div class="prose prose-lg max-w-none">
      <Content />
    </div>
  </article>
</BaseLayout>
