---
import { Font } from 'astro:assets';
import siteConfig from '@data/site-config';
import '@/styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: { src: string; alt?: string };
  pageType?: 'website' | 'article';
}

const { title, description = siteConfig.description, image, pageType = 'website' } = Astro.props;
const resolvedTitle = title ? `${title} | ${siteConfig.title}` : `${siteConfig.title} — ${siteConfig.subtitle}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
function resolveOgImage(pathname: string, image?: { src: string }) {
  if (image?.src) return new URL(image.src, Astro.site).toString();

  let ogPath = '/og/default.png';
  const cleanPath = pathname.replace(/\/$/, '');
  // Only individual posts/projects have a per-slug OG image. Pagination/index
  // pages have no such image — fall back to the default instead of advertising a
  // broken social card. Articles route at /writing/ (Stage C rename), but their
  // pre-generated OG assets stay under /og/blog/<slug>.png — an internal asset
  // convention keyed by the unchanged slug, deliberately not renamed with the route.
  if (cleanPath.startsWith('/writing/')) {
    const slug = cleanPath.slice('/writing/'.length);
    if (slug && !/^\d+$/.test(slug)) ogPath = `/og/blog/${slug}.png`;
  } else if (cleanPath.startsWith('/projects/')) {
    const slug = cleanPath.slice('/projects/'.length);
    if (slug && !/^\d+$/.test(slug)) ogPath = `/og/projects/${slug}.png`;
  }
  return new URL(ogPath, Astro.site).toString();
}

const resolvedImage = resolveOgImage(Astro.url.pathname, image);
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<!-- Self-hosted brand faces (Astro Fonts API). Emits @font-face + preload.
     Preload only the above-the-fold faces: body serif (400) and heading sans
     (700); mono is below the fold, so it loads without a preload. -->
<Font cssVariable="--font-libre" preload={[{ weight: 400, style: 'normal' }]} />
<Font cssVariable="--font-sora" preload={[{ weight: 700, style: 'normal' }]} />
<Font cssVariable="--font-mono-neon" />
<Font cssVariable="--font-mono-krypton" />
<link rel="canonical" href={canonicalURL} />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="application/rss+xml" title={siteConfig.title} href="/rss.xml" />

<title>{resolvedTitle}</title>
<meta name="description" content={description} />

<!-- No-JS fallback: scroll-reveal elements are opacity:0 until the IntersectionObserver
     runs, so without JS the homepage sections and preview cards would be blank. -->
<noscript>
  <style>
    .reveal {
      opacity: 1;
      translate: none;
    }
  </style>
</noscript>

<!-- Open Graph -->
<meta property="og:type" content={pageType} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={resolvedTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={resolvedImage} />
<meta property="og:site_name" content={siteConfig.title} />
<meta property="og:locale" content="en_AU" />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@jasonm4130" />
<meta name="twitter:creator" content="@jasonm4130" />
<meta name="twitter:title" content={resolvedTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={resolvedImage} />

<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<script is:inline src="/theme-toggle.js"></script>
<!-- Skopia analytics (self-hosted, cookieless) — app.skopia.dev -->
<script
  is:inline
  defer
  src="https://app.skopia.dev/skopia.js"
  data-site="jasonmatthew-dev"
  data-endpoint="https://app.skopia.dev/e"></script>
