---
import siteConfig from '@data/site-config';

const socialLabels: Record<string, string> = { github: 'GitHub', linkedin: 'LinkedIn', x: 'X' };
const currentYear = new Date().getFullYear();
// Cloudflare Pages/Workers Builds injects the commit SHA at build; absent locally.
const commit = (process.env.CF_PAGES_COMMIT_SHA ?? '').slice(0, 7);
---

<footer class="footx">
  <div class="shell">
    <div class="foot-top">
      <div class="foot-brand">
        <a href="/" class="brand">Jason Matthew<span class="dot">.</span></a>
        <p class="foot-tag">
          AI-native builder &amp; writer. I build production AI systems and write about the engineering underneath.
        </p>
      </div>
      <div class="foot-cols">
        <div class="foot-col site">
          <div class="foot-h">Site</div>
          {siteConfig.footerNavLinks.map((link) => <a href={link.href}>{link.text}</a>)}
        </div>
        <div class="foot-col elsewhere">
          <div class="foot-h">Elsewhere</div>
          {
            siteConfig.socialLinks.map((link) => (
              <a href={link.href} target="_blank" rel="noopener noreferrer">
                {socialLabels[link.platform] ?? link.platform}
              </a>
            ))
          }
          <a href="/rss.xml" class="rss">RSS</a>
          <a href="/contact">Contact</a>
        </div>
      </div>
    </div>
    <div class="foot-bot">
      <span class="foot-copy">&copy; {currentYear} Jason Matthew</span>
      <span class="foot-build">
        Built with Astro on Cloudflare &middot; Set in Libre Baskerville &amp; Sora{
          commit && (
            <>
              {' '}
              &middot; <span class="sha">{commit}</span>
            </>
          )
        }
      </span>
    </div>
  </div>
</footer>

<style>
  .footx {
    border-top: 1px solid var(--border);
    margin-top: 36px;
    padding-top: 44px;
    padding-bottom: 60px;
  }

  .foot-top {
    display: flex;
    justify-content: space-between;
    gap: 48px;
    flex-wrap: wrap;
  }

  .foot-brand {
    max-width: 34ch;
  }

  .brand {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 1.02rem;
    letter-spacing: -0.01em;
    color: var(--ink);
    text-decoration: none;
  }

  .brand .dot {
    color: var(--coral);
  }

  .foot-tag {
    font-family: var(--font-serif);
    font-size: 0.9rem;
    color: var(--muted);
    line-height: 1.62;
    margin: 13px 0 0;
  }

  .foot-cols {
    display: flex;
    gap: 60px;
  }

  .foot-col {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .foot-h {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--faint);
    margin-bottom: 2px;
  }

  .foot-col a {
    font-family: var(--font-sans);
    font-size: 0.9rem;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.18s ease;
  }

  .foot-col a:hover {
    color: var(--ink);
  }

  .foot-col a.rss:hover {
    color: var(--coral);
  }

  .foot-bot {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
    margin-top: 38px;
    padding-top: 20px;
    border-top: 1px solid var(--hair);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--faint);
    letter-spacing: 0.02em;
  }

  .foot-bot .sha {
    color: var(--coral);
  }

  @media (max-width: 760px) {
    .footx {
      padding-top: 34px;
      padding-bottom: 48px;
    }

    .foot-top {
      flex-direction: column;
      gap: 26px;
    }

    .foot-tag,
    .foot-col.site,
    .foot-build {
      display: none;
    }

    .foot-cols {
      gap: 0;
      width: 100%;
    }

    .foot-col.elsewhere .foot-h {
      display: none;
    }

    .foot-col.elsewhere {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 12px 20px;
    }

    .foot-bot {
      margin-top: 26px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .foot-col a {
      transition: none;
    }
  }
</style>
