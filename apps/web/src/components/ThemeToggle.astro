<button
  id="theme-toggle"
  type="button"
  class="theme-toggle flex h-9 w-9 items-center justify-center rounded-full text-[var(--color-muted)] transition-[transform,color] duration-200 hover:scale-105 hover:text-[var(--color-fg)]"
  aria-label="Toggle theme"
  aria-pressed="false"
>
  <!-- Sun ↔ moon morph. State is driven from global.css off the token tri-state
       (explicit data-theme, else system) so the icon always matches the palette. -->
  <svg class="icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <mask id="theme-moon-mask">
      <rect x="0" y="0" width="24" height="24" fill="white"></rect>
      <circle class="moon-cut" cx="15" cy="8" r="6" fill="black"></circle>
    </mask>
    <circle class="core" cx="12" cy="12" r="5" fill="currentColor" mask="url(#theme-moon-mask)"></circle>
    <g class="rays">
      <line x1="12" y1="1.5" x2="12" y2="3.6"></line>
      <line x1="12" y1="20.4" x2="12" y2="22.5"></line>
      <line x1="1.5" y1="12" x2="3.6" y2="12"></line>
      <line x1="20.4" y1="12" x2="22.5" y2="12"></line>
      <line x1="4.6" y1="4.6" x2="6.1" y2="6.1"></line>
      <line x1="17.9" y1="17.9" x2="19.4" y2="19.4"></line>
      <line x1="4.6" y1="19.4" x2="6.1" y2="17.9"></line>
      <line x1="17.9" y1="6.1" x2="19.4" y2="4.6"></line>
    </g>
  </svg>
</button>
