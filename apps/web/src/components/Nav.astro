---
import siteConfig from '@data/site-config';
import ThemeToggle from './ThemeToggle.astro';

const pathname = Astro.url.pathname;
const isActive = (href: string) => pathname === href || (href !== '/' && pathname.startsWith(href));
---

<nav class="nb-nav">
  <div class="shell nav-in">
    <a href="/" class="brand" aria-label={siteConfig.title}>Jason Matthew<span class="dot">.</span></a>
    <div class="nav-actions">
      <div class="nav-links hidden sm:flex">
        {
          siteConfig.headerNavLinks.map((link) => (
            <a href={link.href} class:list={['nl', { active: isActive(link.href) }]}>
              {link.text}
            </a>
          ))
        }
        <a href="/rss.xml" class="nl rss">RSS</a>
      </div>
      <ThemeToggle />
      <button
        id="mobile-menu-toggle"
        type="button"
        class="rule-menu"
        aria-label="Toggle menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="mk" aria-hidden="true"></span>
        <span class="mk" aria-hidden="true"></span>
        <span class="mk" aria-hidden="true"></span>
      </button>
    </div>
  </div>
  <div id="mobile-menu" class="mobile-menu sm:hidden">
    <div class="shell mobile-menu-inner">
      {
        siteConfig.headerNavLinks.map((link) => (
          <a href={link.href} class:list={['rrow', { active: isActive(link.href) }]}>
            <span class="lk">{link.text}</span>
            <span class="rule" aria-hidden="true" />
          </a>
        ))
      }
      <a href="/rss.xml" class="rrow rss">
        <span class="lk">RSS</span>
        <span class="rule" aria-hidden="true"></span>
      </a>
    </div>
  </div>
</nav>

<style>
  .nb-nav {
    border-bottom: 1px solid var(--border);
    background: var(--paper);
  }

  .nav-in {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 62px;
  }

  .brand {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 1rem;
    letter-spacing: -0.01em;
    color: var(--ink);
    text-decoration: none;
  }

  .brand .dot {
    color: var(--coral);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 22px;
  }

  .nav-links {
    align-items: center;
    gap: 26px;
  }

  .nl {
    font-family: var(--font-mono);
    font-size: 0.73rem;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--faint);
    text-decoration: none;
    transition: color 0.18s ease;
  }

  .nl:hover,
  .nl.active {
    color: var(--ink);
  }

  .nl.rss {
    color: var(--coral);
  }

  /* Three right-aligned ruled marks; on open they go coral and level to 20px. */
  .rule-menu {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    justify-content: center;
    gap: 4px;
    height: 2.25rem;
    width: 2.25rem;
    padding: 0 3px;
    color: var(--muted);
    background: none;
    border: 0;
    cursor: pointer;
  }

  .rule-menu:hover {
    color: var(--ink);
  }

  .rule-menu .mk {
    height: 2px;
    background: currentColor;
    border-radius: 2px;
    transition:
      width var(--dur-3) var(--ease-out),
      background var(--dur-2) ease;
  }

  .rule-menu .mk:nth-child(1) {
    width: 20px;
  }

  .rule-menu .mk:nth-child(2) {
    width: 14px;
  }

  .rule-menu .mk:nth-child(3) {
    width: 17px;
  }

  .rule-menu[aria-expanded='true'] {
    color: var(--coral);
  }

  .rule-menu[aria-expanded='true'] .mk {
    width: 20px;
    background: var(--coral);
  }

  /* Scoped `display: flex` above outweighs Tailwind's `sm:hidden` utility, so the
     desktop hide must live here too (mirrors `.nav-links`' `hidden sm:flex`). */
  @media (min-width: 640px) {
    .rule-menu {
      display: none;
    }
  }

  .mobile-menu-inner {
    display: flex;
    flex-direction: column;
    padding-top: 12px;
    padding-bottom: 20px;
  }

  @media (prefers-reduced-motion: reduce) {
    .nl {
      transition: none;
    }

    .rule-menu .mk {
      transition: none;
    }
  }
</style>

<script>
  function setupMobileMenu() {
    const toggle = document.getElementById('mobile-menu-toggle') as HTMLButtonElement | null;
    const menu = document.getElementById('mobile-menu') as HTMLElement | null;
    if (!toggle || !menu) return;

    // After the guard, TypeScript still widens back to nullable inside closures.
    // Capture as non-nullable references for use in nested functions.
    const toggleEl: HTMLButtonElement = toggle;
    const menuEl: HTMLElement = menu;

    // Ensure menu is closed on page load (Astro view transitions keep DOM state)
    menuEl.classList.remove('is-open');
    toggleEl.setAttribute('aria-expanded', 'false');

    function openMenu() {
      menuEl.classList.add('is-open');
      toggleEl.setAttribute('aria-expanded', 'true');
      document.addEventListener('keydown', onKeyDown);
      document.addEventListener('click', onClickOutside);
      const firstFocusable = menuEl.querySelector<HTMLElement>('a, button');
      firstFocusable?.focus();
    }

    function closeMenu() {
      menuEl.classList.remove('is-open');
      toggleEl.setAttribute('aria-expanded', 'false');
      document.removeEventListener('keydown', onKeyDown);
      document.removeEventListener('click', onClickOutside);
      toggleEl.focus();
    }

    function onClickOutside(e: MouseEvent) {
      const target = e.target as Node;
      if (!menuEl.contains(target) && !toggleEl.contains(target)) {
        closeMenu();
      }
    }

    function onKeyDown(e: KeyboardEvent) {
      if (e.key === 'Escape') {
        closeMenu();
        return;
      }

      if (e.key !== 'Tab') return;

      const focusable = menuEl.querySelectorAll<HTMLElement>('a, button');
      if (focusable.length === 0) return;

      const first = focusable[0];
      const last = focusable[focusable.length - 1];

      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    }

    toggleEl.addEventListener('click', () => {
      const isOpen = toggleEl.getAttribute('aria-expanded') === 'true';
      if (isOpen) {
        closeMenu();
      } else {
        openMenu();
      }
    });
  }

  document.addEventListener('astro:page-load', setupMobileMenu);
</script>
