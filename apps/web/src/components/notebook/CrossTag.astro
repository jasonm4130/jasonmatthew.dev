---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'span'> {
  /** `tag` = boxed coral chip (.xtag); `badge` = italic serif aside (.xbadge). */
  variant?: 'tag' | 'badge';
}

const { variant = 'tag', class: className, ...rest } = Astro.props;
---

<span class:list={[variant === 'badge' ? 'xbadge' : 'xtag', className]} {...rest}><slot /></span>

<style>
  .xtag {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.57rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    line-height: 1.3;
    color: var(--coral);
    border: 1px solid var(--coral);
    border-radius: 3px;
    padding: 2px 6px;
  }

  .xbadge {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.74rem;
    color: var(--faint);
  }
</style>
