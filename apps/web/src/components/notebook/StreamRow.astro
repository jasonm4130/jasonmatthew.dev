---
import type { HTMLAttributes } from 'astro/types';
import { kindLabel } from '@data/kinds';

interface Props extends HTMLAttributes<'a'> {
  href: string;
  /** Pre-formatted short date, e.g. "02 Jun". */
  date: string;
  title: string;
  /** Article kind slug; rendered as its label in the trailing column. */
  kind?: string;
}

const { href, date, title, kind, class: className, ...rest } = Astro.props;
---

<a class:list={['wrow', className]} href={href} {...rest}>
  <span class="wd">{date}</span>
  <span class="wt">{title}</span>
  {kind && <span class="wk">{kindLabel(kind)}</span>}
</a>

<style>
  .wrow {
    display: grid;
    grid-template-columns: 62px 1fr auto;
    gap: 16px;
    align-items: baseline;
    padding: 12px 0;
    border-top: 1px solid var(--hair);
    color: inherit;
    text-decoration: none;
  }

  .wrow:first-child {
    border-top: 0;
  }

  .wd {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--faint);
  }

  .wt {
    font-family: var(--font-serif);
    font-size: 1.02rem;
    color: var(--ink);
    line-height: 1.45;
    transition: color 0.18s ease;
  }

  .wrow:hover .wt {
    color: var(--coral);
  }

  .wk {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--faint);
  }

  @media (prefers-reduced-motion: reduce) {
    .wt {
      transition: none;
    }
  }
</style>
