/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Only content-hashed bundles are safe to cache immutably. Unversioned public
# files (e.g. /favicon.svg) must stay revalidatable, or a returning visitor
# can retain a stale copy for up to a year after a deploy.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/og-default.jpg
  Cache-Control: public, max-age=86400

/favicon.svg
  Cache-Control: public, max-age=86400
