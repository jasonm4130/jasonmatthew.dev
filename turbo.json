{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "globalDependencies": ["scripts/check-contrast.mjs"],
  "tasks": {
    "generate:og": {
      "inputs": ["scripts/**", "packages/content/**"],
      "outputs": [
        "apps/web/public/og/**",
        "apps/web/public/favicon-512.png",
        "apps/web/public/apple-touch-icon.png",
        "apps/web/public/favicon.svg"
      ]
    },
    "build": {
      "dependsOn": ["^build", "generate:og", "test"],
      "inputs": ["src/**", "public/**", "astro.config.*", "tsconfig.json", "package.json"],
      "outputs": ["dist/**", ".astro/**"]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "test/**",
        "vitest.config.ts",
        "astro.config.*",
        "tsconfig.json",
        "package.json",
        "../../packages/content/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {
      "dependsOn": ["^build"]
    }
  }
}
